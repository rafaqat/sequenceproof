{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/protocol/index.ts", "src/node/index.ts"],
  "out": "../../doc/typedoc",
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": ["Class", "Interface", "Function", "Variable", "TypeAlias"]
}
