# frozen_string_literal: true

if defined?(SequenceProof::Rails) && SequenceProof::Rails.respond_to?(:configure)
  require "securerandom"

  test_process_token = SecureRandom.hex(32)
  SequenceProof::Rails.configure do |config|
    config.enabled_environments = %w[test]
    config.mount_path = "<%= options[:mount_path] %>"
    # Campaign tasks replace this with a shared ephemeral token. The fallback keeps ordinary test
    # suite boots self-contained and exists only inside this process; production never loads the gem.
    config.token = -> { ENV["SEQUENCEPROOF_TOKEN"].presence || test_process_token }
  end

  Rails.application.reloader.to_prepare do
    adapter_paths = Rails.root.glob("{spec,test}/sequenceproof/adapters/*_adapter.rb")
    SequenceProof::Rails.__reload_app_adapters!(adapter_paths)
  end
end
